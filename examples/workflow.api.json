{
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0],
      "seed": "$seed",
      "steps": "$steps",
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "$checkpoint"}},
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": "$width", "height": "$height", "batch_size": 1}
  },
  "6": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["4", 1], "text": "$prompt"}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["4", 1], "text": ""}},
  "8": {"class_type": "SaveImage", "inputs": {"images": ["9", 0], "filename_prefix": "$filename"}},
  "9": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}}
}
